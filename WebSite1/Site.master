<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.master.cs" Inherits="SiteMaster" %>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head runat="server">
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>كودلوجستك — مرجع شامل للغات البرمجية</title>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
  <link href="Site.css" rel="stylesheet" type="text/css">
  <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
<form id="masterForm" runat="server">

<div class="orb orb-1"></div>
<div class="orb orb-2"></div>

<!-- HEADER -->
<header>
  <div class="header-inner">
    <div class="logo">💻 <span>كودلوجستك</span></div>
    <nav class="main-nav">
      <button type="button" id="nav-home"      onclick="location.href='Default.aspx'">🏠 الرئيسية</button>
      <button type="button" id="nav-vars"      onclick="location.href='Vars.aspx'">📋 Variables</button>
      <button type="button" id="nav-print"     onclick="location.href='Print.aspx'">🖨️ Print</button>
      <button type="button" id="nav-for"       onclick="location.href='For.aspx'">🔁 For Loop</button>
      <button type="button" id="nav-conditions" onclick="location.href='Conditions.aspx'">🔀 If/While</button>
      <button type="button" id="nav-switch"    onclick="location.href='Switch.aspx'">🔧 Switch</button>
      <button type="button" id="nav-functions" onclick="location.href='Functions.aspx'">⚙️ Functions</button>
      <button type="button" id="nav-arrays"    onclick="location.href='Arrays.aspx'">📦 Arrays</button>
      <button type="button" id="nav-oop"       onclick="location.href='OOP.aspx'">🏗️ OOP</button>
      <button type="button" id="nav-refs"      onclick="location.href='Refs.aspx'">📚 المراجع</button>
    </nav>
  </div>
</header>

<!-- Mobile Nav -->
<div class="mobile-nav">
  <button type="button" onclick="location.href='Default.aspx'">🏠 الرئيسية</button>
  <button type="button" onclick="location.href='Vars.aspx'">📋 Vars</button>
  <button type="button" onclick="location.href='Print.aspx'">🖨️ Print</button>
  <button type="button" onclick="location.href='For.aspx'">🔁 For</button>
  <button type="button" onclick="location.href='Conditions.aspx'">🔀 If/While</button>
  <button type="button" onclick="location.href='Switch.aspx'">🔧 Switch</button>
  <button type="button" onclick="location.href='Functions.aspx'">⚙️ Functions</button>
  <button type="button" onclick="location.href='Arrays.aspx'">📦 Arrays</button>
  <button type="button" onclick="location.href='OOP.aspx'">🏗️ OOP</button>
  <button type="button" onclick="location.href='Refs.aspx'">📚 المراجع</button>
</div>

<!-- PAGE CONTENT -->
<asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>

<!-- FOOTER -->
<footer>
  <p>كودلوجستك &copy; 2026 — مرجع شامل للغات البرمجية بالعربية<br>صُنع بـ  أديب , وليد</p>
</footer>

<script src="Site.js" type="text/javascript"></script>
<asp:ContentPlaceHolder ID="scripts" runat="server"></asp:ContentPlaceHolder>

<script type="text/javascript">
  // Highlight active nav button based on current page
  (function() {
    var page = window.location.pathname.split('/').pop().replace('.aspx','').toLowerCase();
    if (!page || page === 'default') page = 'home';
    var btn = document.getElementById('nav-' + page);
    if (btn) btn.classList.add('active');
  })();
</script>

</form>
</body>
</html>
